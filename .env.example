# Copy this file to ".env" for local use, or add these as
# Environment Variables in your host's dashboard (e.g. Hostinger).
# Never commit the real .env file.

# Password for the admin panel at /admin
ADMIN_PASSWORD=change-me-to-something-long

# Random text used to sign the login cookie (any long random string)
SESSION_SECRET=replace-with-a-long-random-string

# Where admin edits and uploaded images are stored.
# Leave empty locally. On Hostinger set it to a folder OUTSIDE the app,
# so new deployments don't wipe your content:
# STORAGE_DIR=~/art-storage

# Port (hosts usually set this for you)
PORT=3000
